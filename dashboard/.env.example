# ─────────────────────────────────────────────────────────────────────────────
# Kitchen dashboard configuration. Copy to .env.local and fill in.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local dev  -> Session pooler,     port 5432
# Vercel     -> Transaction pooler, port 6543  (serverless-safe)
# Supabase dashboard > Connect.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Shared password for the whole kitchen team. Anyone with it can see every
# order and move it through the kitchen, so treat it like a door key.
DASHBOARD_PASSWORD=change-me

# Signs the login cookie. Any long random string; changing it logs everyone out.
# Generate one: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# OPTIONAL. Supabase signs its pooler certificates with its own CA, which Node
# does not trust by default. Leave blank and the connection is still encrypted
# but the certificate chain is not verified (same as sslmode=require). Paste the
# PEM from Supabase > Settings > Database > SSL Configuration to verify properly.
SUPABASE_CA_CERT=
