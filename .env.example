# ─────────────────────────────────────────────────────────────────────────────
# Used by the n8n build scripts (n8n/build_workflow.py, n8n/build_notifier.py)
# and the demo-data seeder (db/seed_demo_orders.py).
#
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of your n8n instance, no trailing slash.
# Self-hosted or n8n Cloud both work.
N8N_URL=https://n8n.example.com

# n8n API key. Create one at: Settings > n8n API > Create an API key
N8N_API_KEY=

# Postgres connection string for your Supabase project.
# Supabase dashboard > Connect > Session pooler (port 5432).
# Used only by the seed script; the app itself is configured separately.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
